{
  "name": "lostdiary-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create lostdiary",
    "db:migrate": "wrangler d1 execute lostdiary --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute lostdiary --remote --file=./seed.sql",
    "db:local": "wrangler d1 execute lostdiary --local --file=./schema.sql && wrangler d1 execute lostdiary --local --file=./seed.sql",
    "test": "node test/run.js"
  },
  "devDependencies": { "wrangler": "^3.90.0" }
}
